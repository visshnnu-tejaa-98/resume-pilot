# Clerk dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk dashboard -> Webhooks -> Add Endpoint -> Signing Secret
# (needs a public URL Clerk can reach — e.g. an ngrok tunnel locally,
# or your deployed URL; see tasks/testing/m1-foundation/04-auth-clerk-integration.md)
CLERK_WEBHOOK_SECRET=

NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Public base URL used in email links. Set to the Railway web domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

DATABASE_URL=postgres://postgres:postgres@localhost:55432/resume_pilot

# Optional: fake svix secrets for app/api/webhooks/clerk/route.test.ts.
# Leave blank — the test generates a random one at runtime if unset.
TEST_CLERK_WEBHOOK_SECRET=
TEST_CLERK_WEBHOOK_WRONG_SECRET=

# Email — Nodemailer over any SMTP provider (prd.md §13.2)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS="Resume Pilot <noreply@resumepilot.app>"

# File storage — ImageKit dashboard -> Developer options (prd.md §5.2)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Salt for hashing client IPs / device ids in referral abuse checks (prd.md §2.1). Any long random string.
ABUSE_HASH_SALT=

# Razorpay — dashboard -> Account & Settings -> API Keys (use test-mode keys locally) (prd.md §11)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks: URL <app>/api/webhooks/razorpay, events payment.captured, payment.failed,
# refund.processed, refund.failed. This is the secret you type there (not the key secret).
RAZORPAY_WEBHOOK_SECRET=

# Email (prd.md §13) — sending domain, replies, unsubscribe, throttle
# Long random string; signs one-click unsubscribe links (they never expire, so don't rotate casually).
EMAIL_UNSUBSCRIBE_SECRET=
# Where replies go (falls back to SUPPORT_EMAIL).
EMAIL_REPLY_TO=
SUPPORT_EMAIL=
# DKIM selector your SMTP provider gave you (the part before ._domainkey), for the admin domain checks.
EMAIL_DKIM_SELECTOR=
# Campaign sends per minute — keep below the provider's limit (also set on the worker).
EMAIL_CAMPAIGN_PER_MINUTE=60
