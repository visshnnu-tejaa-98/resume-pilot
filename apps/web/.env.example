# Clerk dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk dashboard -> Webhooks -> Add Endpoint -> Signing Secret
# (needs a public URL Clerk can reach — e.g. an ngrok tunnel locally,
# or your deployed URL; see tasks/testing/m1-foundation/04-auth-clerk-integration.md)
CLERK_WEBHOOK_SECRET=

NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

DATABASE_URL=postgres://postgres:postgres@localhost:55432/resume_pilot
