# Worker env. Locally: copy to .env.local (loaded by `pnpm dev`). On Railway: service variables.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/resume_pilot
REDIS_URL=redis://127.0.0.1:6379

# Base URL for links in emails (the web app's public URL)
APP_URL=http://localhost:3000

# Launch coupon shown in the welcome email (read from the coupons table)
LAUNCH_COUPON_CODE=EARLYBIRD

# Email — Nodemailer over any SMTP provider (prd.md §13.2)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS="Resume Pilot <noreply@resumepilot.app>"

# File storage — ImageKit (prd.md §5.2), for the 30-day upload cleanup
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# OpenAI for extraction, JD analysis, generation and ATS scoring.
# Local dev: leave empty (or set an invalid key) and the worker uses a mock AI that returns
# sample data for free — the whole flow still runs. Never used in production: there a missing
# or rejected key fails the job.
OPENAI_API_KEY=
# Local only: 1 = use the mock AI even when OPENAI_API_KEY is valid (save money while testing UI).
AI_MOCK=
# Optional; defaults to the model in packages/ai (DEFAULT_EXTRACTION_MODEL, gpt-5.1).
# A cheaper model such as gpt-5-mini is fine for local testing.
OPENAI_EXTRACTION_MODEL=
# Email footer + header (optional; placeholders are shown when unset)
SUPPORT_EMAIL=
POSTAL_ADDRESS=
# Absolute https URL to a PNG logo (email clients block SVG/data: images).
# The web app serves one at <APP_URL>/email-logo.png. Must be publicly reachable — unset falls back to a drawn tile.
EMAIL_LOGO_URL=
# Signs unsubscribe links in marketing email — must match the web app's value.
EMAIL_UNSUBSCRIBE_SECRET=
EMAIL_REPLY_TO=
# Campaign/nudge sends per minute across all workers (below the SMTP provider's limit, prd.md §13.7).
EMAIL_CAMPAIGN_PER_MINUTE=60

# PDF export (Puppeteer). Set to 1 in Docker/Railway (container runs as root, Chromium's sandbox can't start).
# Leave unset locally on macOS.
PUPPETEER_NO_SANDBOX=
